# Copy to apps/web/.env.local for local overrides. All are optional.

# Where /api/* is proxied. Must be reachable from the Next.js server, not the browser.
API_ORIGIN=http://127.0.0.1:8000

# Where the Pyodide distribution (~14 MB) is fetched from.
#
# Unset (the default) means jsDelivr, pinned at build time to the exact version of
# the installed npm package — this is what keeps the platform inside a free
# hosting tier's bandwidth allowance.
#
# Set to /pyodide/ to serve it from this origin instead. The build then copies the
# distribution into public/pyodide/. Worth doing if your learners are behind a
# network that blocks public CDNs. Must end with a slash.
#
# `npm run dev` and the test suites set this to /pyodide/ themselves.
# PYODIDE_INDEX_URL=/pyodide/
